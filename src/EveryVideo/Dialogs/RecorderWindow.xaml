<local:CardWindow x:Class="EveryVideo.Dialogs.RecorderWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:EveryVideo"
                  Title="화면 녹화" CardIcon="{StaticResource IcRecord}" Topmost="True" ShowInTaskbar="True">
    <StackPanel Width="360">
        <StackPanel x:Name="OptionsPanel">
            <TextBlock Text="녹화할 화면" Style="{StaticResource Label}" Margin="0,0,0,4" />
            <WrapPanel>
                <RadioButton x:Name="PrimaryRadio" Content="주 모니터" GroupName="area" IsChecked="True" />
                <RadioButton x:Name="AllRadio" Content="모든 모니터" GroupName="area" />
            </WrapPanel>
            <TextBlock Text="소리 녹음" Style="{StaticResource Label}" />
            <ComboBox x:Name="AudioCombo" />
            <TextBlock Text="컴퓨터 소리를 녹음하려면 '스테레오 믹스' 장치를 켜서 고르세요. (사운드 설정 › 녹음 장치)"
                       TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,6,0,0" />
            <CheckBox x:Name="HideCheck" Content="녹화하는 동안 EveryVideo 창 최소화" IsChecked="False" Margin="0,10,0,0" />
        </StackPanel>

        <Border x:Name="RecPanel" Visibility="Collapsed" Background="{StaticResource CardHigh}" CornerRadius="12" Padding="16,14">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Fill="{StaticResource Danger}" VerticalAlignment="Center" />
                <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="22" FontWeight="Bold" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="표준 Windows 화면 캡쳐를 사용합니다. 보호된 콘텐츠는 검게 녹화될 수 있습니다." FontSize="11.5" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="FolderButton" Content="저장 폴더" Style="{StaticResource TextButton}" Click="Folder_Click" />
            <Button x:Name="StartButton" Content="녹화 시작" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
        </StackPanel>
    </StackPanel>
</local:CardWindow>
