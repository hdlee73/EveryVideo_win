<local:CardWindow x:Class="EveryVideo.Dialogs.ConcatWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:EveryVideo"
                  Title="동영상 이어붙이기" CardIcon="{StaticResource IcMerge}">
    <StackPanel Width="520">
        <TextBlock Text="위에서부터 순서대로 하나의 MP4 로 합칩니다." Foreground="{StaticResource TextDim}" />
        <Border Background="{StaticResource CardHigh}" CornerRadius="12" Margin="0,10,0,0" Padding="4">
            <ListBox x:Name="FileList" Height="220" AllowDrop="True" Drop="FileList_Drop">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcAdd}" ToolTip="파일 추가" Click="Add_Click" />
            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcUp}" ToolTip="위로" Click="Up_Click" />
            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcDown}" ToolTip="아래로" Click="Down_Click" />
            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcDelete}" ToolTip="빼기" Click="Remove_Click" />
        </StackPanel>

        <TextBlock Text="결과 해상도" Style="{StaticResource Label}" />
        <ComboBox x:Name="SizeCombo" SelectedIndex="0">
            <ComboBoxItem Content="첫 번째 동영상과 같게" />
            <ComboBoxItem Content="1920 × 1080 (FHD)" />
            <ComboBoxItem Content="1280 × 720 (HD)" />
            <ComboBoxItem Content="854 × 480" />
            <ComboBoxItem Content="1080 × 1920 (세로 FHD)" />
            <ComboBoxItem Content="720 × 1280 (세로 HD)" />
        </ComboBox>
        <CheckBox x:Name="FastCheck" Content="빠르게 붙이기 (모두 같은 형식·크기일 때, 다시 인코딩하지 않음)" Margin="0,10,0,0" />

        <ProgressBar x:Name="Progress" Margin="0,14,0,0" Maximum="1" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" Margin="0,6,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="닫기" Style="{StaticResource TextButton}" Click="Cancel_Click" />
            <Button x:Name="SaveButton" Content="합치기" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</local:CardWindow>
