<local:CardWindow x:Class="EveryVideo.Dialogs.RemoteWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:EveryVideo"
                  Title="네트워크 (FTP · SMB)" CardIcon="{StaticResource IcServer}">
    <Grid Width="760" Height="440">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcAdd}" ToolTip="서버 추가" Click="AddServer_Click" />
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcEdit}" ToolTip="고치기" Click="EditServer_Click" />
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcDelete}" ToolTip="지우기" Click="DeleteServer_Click" />
            </StackPanel>
            <Border Background="{StaticResource CardHigh}" CornerRadius="12" Padding="4">
                <ListBox x:Name="ServerList" SelectionChanged="ServerList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="{StaticResource IcUp}" ToolTip="상위 폴더" Click="Up_Click" />
                <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextDim}" />
            </DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="이 폴더 모두 재생" Style="{StaticResource TextButton}" Click="PlayAll_Click" />
                <Button Content="재생" Style="{StaticResource PrimaryButton}" Click="Play_Click" />
            </StackPanel>
            <Border Background="{StaticResource CardHigh}" CornerRadius="12" Padding="4">
                <ListBox x:Name="ItemList" MouseDoubleClick="ItemList_DoubleClick" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="8,0,0,0" />
                                <Path x:Name="ic" Data="{StaticResource IcMovie}" Fill="{StaticResource TextDim}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter TargetName="ic" Property="Data" Value="{StaticResource IcFolder}" />
                                    <Setter TargetName="ic" Property="Fill" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Grid>
</local:CardWindow>
