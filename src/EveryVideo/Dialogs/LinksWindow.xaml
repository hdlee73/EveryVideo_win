<local:CardWindow x:Class="EveryVideo.Dialogs.LinksWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:EveryVideo"
                  Title="찾은 동영상" CardIcon="{StaticResource IcLink}">
    <DockPanel Width="620" Height="420">
        <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="취소" Style="{StaticResource TextButton}" Click="Cancel_Click" />
            <Button x:Name="DownloadButton" Content="내려받기" Style="{StaticResource TextButton}" Click="Download_Click" />
            <Button x:Name="PlayButton" Content="재생" Style="{StaticResource PrimaryButton}" Click="Play_Click" />
        </StackPanel>
        <Border Background="{StaticResource CardHigh}" CornerRadius="12" Padding="4">
            <ListBox x:Name="List" SelectionMode="Extended" MouseDoubleClick="List_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,3">
                            <Path DockPanel.Dock="Left" Data="{StaticResource IcMovie}" Fill="{StaticResource BrandLight}" Width="16" Height="16"
                                  Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</local:CardWindow>
