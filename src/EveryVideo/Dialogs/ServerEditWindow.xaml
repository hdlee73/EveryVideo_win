<local:CardWindow x:Class="EveryVideo.Dialogs.ServerEditWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:EveryVideo"
                  Title="서버 등록" CardIcon="{StaticResource IcServer}">
    <StackPanel Width="400">
        <WrapPanel>
            <RadioButton x:Name="FtpRadio" Content="FTP" GroupName="kind" IsChecked="True" />
            <RadioButton x:Name="SmbRadio" Content="SMB (윈도우 공유 폴더 · NAS)" GroupName="kind" />
        </WrapPanel>
        <TextBlock Text="표시 이름 (선택)" Style="{StaticResource Label}" />
        <TextBox x:Name="NameBox" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="주소 (IP 또는 이름)" Style="{StaticResource Label}" />
                <TextBox x:Name="HostBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="포트" Style="{StaticResource Label}" />
                <TextBox x:Name="PortBox" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PathLabel" Text="시작 폴더 (선택)" Style="{StaticResource Label}" />
        <TextBox x:Name="PathBox" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="10" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="사용자 (비우면 익명)" Style="{StaticResource Label}" />
                <TextBox x:Name="UserBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="비밀번호" Style="{StaticResource Label}" />
                <PasswordBox x:Name="PassBox" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="취소" Style="{StaticResource TextButton}" Click="Cancel_Click" />
            <Button Content="저장" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</local:CardWindow>
