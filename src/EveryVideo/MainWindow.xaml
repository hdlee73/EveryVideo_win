<Window x:Class="EveryVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="EveryVideo" Width="1320" Height="820" MinWidth="960" MinHeight="460"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        Icon="/Assets/app.ico" AllowDrop="True" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- 위: 이름 + 메뉴 -->
        <Border x:Name="TopMenu" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Height="40">
                <TextBlock Text="EveryVideo" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Brand}" VerticalAlignment="Center" Margin="16,0,10,0" />
                <TextBlock x:Name="TitleText" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,16,0"
                           MaxWidth="420" TextTrimming="CharacterEllipsis" />
                <Menu VerticalAlignment="Center" Background="Transparent">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="파일 열기…" InputGestureText="Ctrl+O" Click="OpenFiles_Click" />
                <MenuItem Header="폴더 열기…" InputGestureText="Ctrl+Shift+O" Click="OpenFolder_Click" />
                <MenuItem Header="주소(URL)·공유 링크 열기…" InputGestureText="Ctrl+U" Click="OpenUrl_Click" />
                <MenuItem Header="주소에서 내려받기…" Click="DownloadUrl_Click" />
                <Separator />
                <MenuItem Header="구글 드라이브…" Click="GoogleDrive_Click" />
                <MenuItem Header="네트워크 (FTP · SMB · WebDAV)…" Click="Remote_Click" />
                <Separator />
                <MenuItem x:Name="RecentMenu" Header="최근 파일" SubmenuOpened="RecentMenu_Opened">
                    <MenuItem Header="(없음)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="캡쳐 저장 폴더 열기" Click="OpenCaptureFolder_Click" />
                <MenuItem Header="동영상 저장 폴더 열기" Click="OpenVideoFolder_Click" />
                <MenuItem Header="내려받은 폴더 열기" Click="OpenDownloadFolder_Click" />
                <MenuItem Header="저장 위치 바꾸기…" Click="ChangeFolders_Click" />
                <Separator />
                <MenuItem Header="끝내기" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="재생(_P)">
                <MenuItem Header="재생 / 일시정지" InputGestureText="Space" Click="PlayPause_Click" />
                <MenuItem Header="정지" Click="Stop_Click" />
                <MenuItem Header="이전" InputGestureText="PgUp" Click="Prev_Click" />
                <MenuItem Header="다음" InputGestureText="PgDn" Click="Next_Click" />
                <Separator />
                <MenuItem Header="구간반복 (A → B → 해제)" InputGestureText="R" Click="AB_Click" />
                <MenuItem Header="반복 방식 바꾸기" InputGestureText="L" Click="Repeat_Click" />
                <MenuItem Header="빠르게" InputGestureText="]" Click="SpeedUp_Click" />
                <MenuItem Header="느리게" InputGestureText="[" Click="SpeedDown_Click" />
                <MenuItem Header="원래 속도 (1배)" InputGestureText="Backspace / \" Click="SpeedReset_Click" />
                <Separator />
                <MenuItem Header="음성 · 자막…" Click="Tracks_Click" />
                <Separator />
                <MenuItem x:Name="ResumeMenu" Header="이어서 재생 (마지막으로 보던 곳부터)" IsCheckable="True" Click="Resume_Click" />
            </MenuItem>
            <MenuItem Header="도구(_T)">
                <MenuItem Header="화면 캡쳐" InputGestureText="C" Click="Capture_Click" />
                <MenuItem Header="구간 저장…" InputGestureText="S" Click="Clip_Click" />
                <MenuItem Header="GIF 만들기…" InputGestureText="G" Click="Gif_Click" />
                <MenuItem Header="썸네일 만들기…" InputGestureText="T" Click="Thumbnail_Click" />
                <MenuItem Header="구간 삭제…" Click="DeleteRange_Click" />
                <MenuItem Header="여러 구간 저장 · 삭제 (구간 목록)" Click="ShowSegments_Click" />
                <Separator />
                <MenuItem Header="동영상 이어붙이기…" Click="Concat_Click" />
                <MenuItem Header="화면 녹화…" Click="Record_Click" />
                <Separator />
                <MenuItem Header="현재 시점 즐겨찾기" InputGestureText="B" Click="AddBookmark_Click" />
                <MenuItem Header="즐겨찾기 모음…" Click="AllBookmarks_Click" />
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="전체화면" InputGestureText="F / Enter" Click="Fullscreen_Click" />
                <MenuItem x:Name="SidePanelMenu" Header="재생목록 · 즐겨찾기 패널" IsCheckable="True" Click="SidePanelMenu_Click" />
                <MenuItem x:Name="TopmostMenu" Header="항상 위" IsCheckable="True" Click="Topmost_Click" />
                <Separator />
                <MenuItem Header="밝기 · 색 조절…" Click="Brightness_Click" />
                <MenuItem Header="화면 비율" Click="Aspect_Click" />
                <MenuItem Header="확대 원래대로" InputGestureText="0" Click="ZoomReset_Click" />
                <Separator />
                <MenuItem x:Name="HwMenu" Header="하드웨어 가속 디코딩" IsCheckable="True" Click="Hw_Click" />
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="단축키" Click="Shortcuts_Click" />
                <MenuItem Header="업데이트 확인…" Click="About_Click" />
                <MenuItem Header="앱 정보" Click="About_Click" />
                <MenuItem x:Name="UpdateMenu" Header="새 버전 내려받기" Visibility="Collapsed" Click="UpdateMenu_Click"
                          Foreground="{StaticResource Accent}" />
            </MenuItem>
            <MenuItem x:Name="UpdateBadge" Header="● 새 버전" Visibility="Collapsed" Foreground="{StaticResource Accent}" Click="About_Click" />
                </Menu>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SideColumn" Width="300" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 아이콘 줄 -->
            <Border x:Name="Rail" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Width="66">
                <DockPanel Margin="0,8">
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Tag="{StaticResource IcInfo}" Content="정보" ToolTip="앱 정보 · 업데이트 확인" Click="About_Click" />
                    <StackPanel>
                        <Button Style="{StaticResource RailButton}" Tag="{StaticResource IcOpen}" Content="열기" ToolTip="파일 열기 (Ctrl+O)" Click="OpenFiles_Click" />
                        <Button Style="{StaticResource RailButton}" Tag="{StaticResource IcFolder}" Content="폴더" ToolTip="폴더 열기 (Ctrl+Shift+O)" Click="OpenFolder_Click" />
                        <Button Style="{StaticResource RailButton}" Tag="{StaticResource IcServer}" Content="네트워크" ToolTip="FTP · SMB · WebDAV" Click="Remote_Click" />
                        <Button Style="{StaticResource RailButton}" Tag="{StaticResource IcLink}" Content="웹 링크" ToolTip="주소 · 공유 링크 · 웹 페이지에서 동영상 찾기 (Ctrl+U)" Click="OpenUrl_Click" />
                        <Button Style="{StaticResource RailButton}" Tag="{StaticResource IcDrive}" Content="드라이브" ToolTip="구글 드라이브" Click="GoogleDrive_Click" />
                        <Border Height="1" Background="{StaticResource Line}" Margin="12,6" />
                        <Button Style="{StaticResource RailButton}" Tag="{StaticResource IcCut}" Content="구간" ToolTip="구간 · 캡쳐 패널" Click="RailSegments_Click" />
                        <Button Style="{StaticResource RailButton}" Tag="{StaticResource IcPlaylist}" Content="목록" ToolTip="재생목록 패널" Click="RailPlaylist_Click" />
                        <Button Style="{StaticResource RailButton}" Tag="{StaticResource IcBookmarks}" Content="즐겨찾기" ToolTip="즐겨찾기 패널" Click="RailBookmarks_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 가운데: 동영상 + 조작 줄 + 필름 타임라인 -->
            <DockPanel Grid.Column="1" Background="{StaticResource WindowBg}">
                <Border x:Name="ControlsHost" DockPanel.Dock="Bottom">
                    <StackPanel x:Name="ControlBar" Margin="14,8,14,14">
                        <!-- 재생 조작 줄 -->
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcPrev}" ToolTip="이전 (PgUp)" Click="Prev_Click" />
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcReplay10}" ToolTip="10초 뒤로 (←: 5초)" Click="Back10_Click" />
                                <Button x:Name="PlayButton" Style="{StaticResource BigIconButton}" Tag="{StaticResource IcPlay}" ToolTip="재생 / 일시정지 (Space, 화면 클릭)"
                                        Click="PlayPause_Click" Margin="6,0" />
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcForward10}" ToolTip="10초 앞으로 (→: 5초)" Click="Fwd10_Click" />
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcNext}" ToolTip="다음 (PgDn)" Click="Next_Click" />
                                <TextBlock x:Name="TimeText" Text="00:00" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13.5" />
                                <TextBlock Text=" / " VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextDim}" />
                                <TextBlock x:Name="DurationText" Text="00:00" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="13.5" Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="{StaticResource IcRemove}" ToolTip="느리게 ([)" Click="SpeedDown_Click" />
                                <Button x:Name="SpeedButton" Content="1.0x" Style="{StaticResource TextButton}" MinWidth="50" Padding="6,0" Margin="0"
                                        Height="30" Foreground="{StaticResource Text}" ToolTip="재생 속도 고르기 ([ ])" Click="Speed_Click" />
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="{StaticResource IcAdd}" ToolTip="빠르게 (])" Click="SpeedUp_Click" />
                                <Button x:Name="SpeedResetButton" Content="1배속으로" Style="{StaticResource TextButton}" MinWidth="0" Padding="12,0" Margin="4,0"
                                        Height="30" Background="{StaticResource Brand}" Foreground="White" ToolTip="원래 속도로 (Backspace, \)"
                                        Click="SpeedReset_Click" Visibility="Collapsed" />
                                <Button x:Name="ABButton" Content="A-B" Style="{StaticResource TextButton}" MinWidth="46" Padding="8,0" Margin="4,0,0,0"
                                        Foreground="{StaticResource Text}" ToolTip="구간반복: 누를 때마다 A 지정 → B 지정 → 해제 (R). 반복 중에는 그 구간 안에서만 이동" Click="AB_Click" />
                                <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcRepeat}" ToolTip="반복" Click="Repeat_Click" />
                                <Button x:Name="BrightnessButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcBrightness}" ToolTip="밝기 · 색 조절" Click="Brightness_Click" />
                                <Button x:Name="ZoomButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcZoom}" ToolTip="확대 (Ctrl+휠, 끌어서 이동)" Click="Zoom_Click" />
                                <Button x:Name="AspectButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcAspect}" ToolTip="화면 비율" Click="Aspect_Click" />
                                <Button x:Name="TracksButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcTracks}" ToolTip="음성 · 자막" Click="Tracks_Click" />
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcCamera}" ToolTip="화면 캡쳐 (C)" Click="Capture_Click" />
                                <Button x:Name="EditButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcCut}" ToolTip="구간 저장 · GIF · 썸네일 · 구간 삭제" Click="EditMenu_Click" />
                                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcVolume}" ToolTip="음소거 (M)" Click="Mute_Click" />
                                <Slider x:Name="VolumeSlider" Width="80" Maximum="200" Value="100" ValueChanged="Volume_Changed"
                                        ToolTip="볼륨 (↑↓, 마우스 휠) · 100% 넘게 키울 수 있음" />
                                <TextBlock x:Name="VolumeText" Text="100%" Width="40" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12" />
                                <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcFullscreen}" ToolTip="전체화면 (F)"
                                        Click="Fullscreen_Click" />
                            </WrapPanel>
                        </DockPanel>

                        <!-- 필름 타임라인: 장면 그림 위를 누르거나 끌어 이동, Shift+끌기로 구간 추가 -->
                        <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
                                Padding="12,12,12,6" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid x:Name="SeekArea" Height="58">
                                    <Border Background="{StaticResource FilmBg}" CornerRadius="8" Margin="7,0" ClipToBounds="True">
                                        <UniformGrid x:Name="FilmStrip" Rows="1" />
                                    </Border>
                                    <Canvas x:Name="SegmentCanvas" ClipToBounds="False" IsHitTestVisible="False" />
                                    <Slider x:Name="SeekSlider" Style="{StaticResource TimelineSlider}" Maximum="1" SmallChange="1000" LargeChange="10000"
                                            MouseMove="Seek_MouseMove" MouseLeave="Seek_MouseLeave" ValueChanged="Seek_ValueChanged" />
                                    <Canvas x:Name="MarkerCanvas" ClipToBounds="False" />
                                </Grid>
                                <Grid x:Name="TickGrid" Margin="7,5,7,0" Height="16" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 동영상 -->
                <Border x:Name="VideoFrame" Background="Black" Margin="14,14,14,0">
                    <vlc:VideoView x:Name="VideoView" Background="Black">
                        <Grid x:Name="Overlay" Background="#01000000"
                              MouseWheel="Overlay_MouseWheel" MouseMove="Overlay_MouseMove"
                              MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
                              MouseRightButtonUp="Overlay_MouseRightButtonUp" AllowDrop="True" Drop="Window_Drop">

                            <!-- 처음 화면 -->
                            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="/Assets/app.png" Width="84" Height="84" Opacity="0.9" />
                                <TextBlock Text="동영상 파일을 끌어다 놓거나 열어 주세요" HorizontalAlignment="Center" FontSize="16" Margin="0,16,0,18" Foreground="White" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Content="파일 열기" Style="{StaticResource PrimaryButton}" Click="OpenFiles_Click" />
                                    <Button Content="폴더 열기" Style="{StaticResource TextButton}" Foreground="{StaticResource BrandLight}" Click="OpenFolder_Click" />
                                    <Button Content="주소·링크" Style="{StaticResource TextButton}" Foreground="{StaticResource BrandLight}" Click="OpenUrl_Click" />
                                    <Button Content="구글 드라이브" Style="{StaticResource TextButton}" Foreground="{StaticResource BrandLight}" Click="GoogleDrive_Click" />
                                    <Button Content="FTP · SMB" Style="{StaticResource TextButton}" Foreground="{StaticResource BrandLight}" Click="Remote_Click" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- 재생이 끝났을 때 -->
                            <StackPanel x:Name="EndPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="재생이 끝났습니다" HorizontalAlignment="Center" FontSize="16" Margin="0,0,0,14" Foreground="White" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Content="다시 재생" Style="{StaticResource PrimaryButton}" Click="Replay_Click" />
                                    <Button Content="다른 파일 열기" Style="{StaticResource TextButton}" Foreground="{StaticResource BrandLight}" Click="OpenFiles_Click" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- 화면 안내 글 -->
                            <Border x:Name="Osd" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="14,8"
                                    Background="#B0000000" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock x:Name="OsdText" FontSize="16" Foreground="White" />
                            </Border>

                            <!-- 전체화면일 때 조작 막대가 여기로 옮겨진다 -->
                            <Border x:Name="FsControlsHost" VerticalAlignment="Bottom" Background="#F2EEF0F3" Visibility="Collapsed" />
                        </Grid>
                    </vlc:VideoView>
                </Border>
            </DockPanel>

            <!-- 동영상과 옆 패널 사이: 끌어서 폭 조절 -->
            <GridSplitter x:Name="SideSplitter" Grid.Column="2" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Cursor="SizeWE" Focusable="False" DragCompleted="SideSplitter_DragCompleted" />

            <!-- 구간·캡쳐 · 재생목록 · 즐겨찾기 -->
            <Border x:Name="SidePanel" Grid.Column="3" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Margin="14,0" Height="42">
                            <RadioButton x:Name="SegmentTab" Content="구간·캡쳐" IsChecked="True" GroupName="side" Checked="SideTab_Changed"
                                         Style="{StaticResource TabRadio}" Margin="0,0,18,0" />
                            <RadioButton x:Name="PlaylistTab" Content="재생목록" GroupName="side" Checked="SideTab_Changed"
                                         Style="{StaticResource TabRadio}" Margin="0,0,18,0" />
                            <RadioButton x:Name="BookmarkTab" Content="즐겨찾기" GroupName="side" Checked="SideTab_Changed"
                                         Style="{StaticResource TabRadio}" />
                        </StackPanel>
                    </Border>

                    <!-- 구간 · 캡쳐 -->
                    <DockPanel x:Name="SegmentPanel" Margin="14,12,14,14">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="저장할 구간" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="SegmentHint" Margin="0,3,0,10" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12"
                                       Text="필름에서 Shift 를 누른 채 끌거나, A-B 를 고른 뒤 '구간 추가'를 누르세요. 체크한 구간을 한꺼번에 저장하거나 지울 수 있습니다." />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource IcCamera}" Content="화면 캡쳐" Margin="0,0,4,8" ToolTip="C" Click="Capture_Click" />
                                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource IcMovie}" Content="GIF" Margin="4,0,0,8" ToolTip="G" Click="Gif_Click" />
                                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource IcApps}" Content="장면 모음" Margin="0,0,4,8" ToolTip="썸네일 만들기 (T)" Click="Thumbnail_Click" />
                                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource IcAdd}" Content="구간 추가" Margin="4,0,0,8" ToolTip="A-B 로 고른 구간을 목록에 넣습니다 (Insert)" Click="AddSegment_Click" />
                                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource IcSave}" Content="한 구간 저장" Margin="0,0,4,8" ToolTip="S" Click="Clip_Click" />
                                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource IcDelete}" Content="구간 삭제" Margin="4,0,0,8" Click="DeleteRange_Click" />
                            </UniformGrid>
                            <Button Style="{StaticResource ToolPrimaryButton}" Tag="{StaticResource IcCut}" Content="체크한 구간 각각 저장" Click="SaveSegmentsEach_Click" />
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="하나로 합쳐 저장" Style="{StaticResource TextButton}" MinWidth="0" Padding="10,0" Height="30" Margin="0" Click="SaveSegmentsJoined_Click" />
                                <Button Content="지운 영상 저장" Style="{StaticResource TextButton}" MinWidth="0" Padding="10,0" Height="30" Margin="0" Foreground="{StaticResource Danger}" Click="DeleteSegments_Click" />
                                <Button Content="모두 지우기" Style="{StaticResource TextButton}" MinWidth="0" Padding="10,0" Height="30" Margin="0" Foreground="{StaticResource TextDim}" Click="ClearSegments_Click" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox x:Name="SegmentBox" MouseDoubleClick="SegmentBox_DoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Margin="0,0,0,8" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="card" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="{StaticResource PanelBg}" Padding="10,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                    Tag="{StaticResource IcClose}" ToolTip="빼기" Click="SegmentRemove_Click" />
                                            <CheckBox IsChecked="{Binding Checked}" VerticalAlignment="Center" Margin="0,0,8,0" Click="SegmentCheck_Click" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Range}" Foreground="{StaticResource Text}" />
                                                <TextBlock Text="{Binding LengthText}" FontSize="11.5" Foreground="{StaticResource TextDim}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Checked}" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter TargetName="card" Property="Background" Value="{StaticResource AccentSoft}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 재생목록 -->
                    <DockPanel x:Name="PlaylistPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="12,0,4,2">
                            <Button x:Name="PlaylistSortButton" DockPanel.Dock="Right" Content="정렬 ▾" Style="{StaticResource TextButton}" MinWidth="0"
                                    Padding="10,0" Height="28" Foreground="{StaticResource Text}" Click="PlaylistSort_Click" />
                            <TextBlock x:Name="PlaylistCount" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"
                                       Text="끌어서 순서 바꾸기 · × 로 빼기" />
                        </DockPanel>
                        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="6,4,6,8">
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcAdd}" ToolTip="파일 추가" Click="AddFiles_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcFolder}" ToolTip="폴더 추가" Click="AddFolder_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcUp}" ToolTip="위로" Click="PlaylistUp_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcDown}" ToolTip="아래로" Click="PlaylistDown_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcDelete}" ToolTip="고른 항목 목록에서 빼기 (Del)" Click="PlaylistRemove_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcClose}" ToolTip="목록 비우기" Click="PlaylistClear_Click" />
                        </UniformGrid>
                        <ListBox x:Name="PlaylistBox" Margin="6,0" MouseDoubleClick="PlaylistBox_DoubleClick" KeyDown="PlaylistBox_KeyDown"
                                 AllowDrop="True" Drop="Window_Drop" SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Background="Transparent">
                                        <Button x:Name="del" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                Tag="{StaticResource IcClose}" ToolTip="목록에서 빼기 (파일은 그대로)" Click="PlaylistItemRemove_Click"
                                                Visibility="Hidden" Margin="4,0,0,0" />
                                        <Path x:Name="ic" Data="{StaticResource IcMovie}" Fill="{StaticResource TextDim}" Width="14" Height="14"
                                              Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock x:Name="tx" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="ic" Property="Data" Value="{StaticResource IcPlay}" />
                                            <Setter TargetName="ic" Property="Fill" Value="{StaticResource Brand}" />
                                            <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Brand}" />
                                            <Setter TargetName="tx" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="del" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 즐겨찾기 (지금 동영상) -->
                    <DockPanel x:Name="BookmarkPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,4,8,8">
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcBookmarkAdd}" ToolTip="현재 시점 즐겨찾기 (B)" Click="AddBookmark_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcEdit}" ToolTip="메모 고치기" Click="EditBookmark_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcDelete}" ToolTip="지우기" Click="DeleteBookmark_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcBookmarks}" ToolTip="모든 동영상의 즐겨찾기" Click="AllBookmarks_Click" />
                        </StackPanel>
                        <TextBlock x:Name="BookmarkEmpty" DockPanel.Dock="Top" Margin="16,8" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                   Text="재생 중에 B 키나 ★ 버튼을 누르면 지금 시점을 즐겨찾기 합니다. 다음에 이 동영상을 열면 여기서 바로 이동할 수 있습니다." />
                        <ListBox x:Name="BookmarkBox" Margin="6,0" MouseDoubleClick="BookmarkBox_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource Brand}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding NoteOrTime}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 탐색 미리보기 -->
        <Popup x:Name="PreviewPopup" PlacementTarget="{Binding ElementName=SeekSlider}" Placement="Relative"
               AllowsTransparency="True" IsHitTestVisible="False">
            <Border Background="#F0131519" CornerRadius="10" Padding="4" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <Border x:Name="PreviewFrame" Width="192" Height="108" CornerRadius="6" Background="Black" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="PreviewTime" HorizontalAlignment="Center" Margin="0,4,0,2" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- 밝기 · 색 -->
        <Popup x:Name="BrightnessPopup" PlacementTarget="{Binding ElementName=BrightnessButton}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource CardBg}" CornerRadius="14" Padding="16,12" Margin="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel Width="260">
                    <DockPanel>
                        <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" />
                        <TextBlock Text="밝기" />
                    </DockPanel>
                    <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" ValueChanged="Adjust_Changed" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="ContrastValue" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" />
                        <TextBlock Text="대비" />
                    </DockPanel>
                    <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" ValueChanged="Adjust_Changed" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="SaturationValue" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" />
                        <TextBlock Text="채도" />
                    </DockPanel>
                    <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" ValueChanged="Adjust_Changed" />
                    <Button Content="원래대로" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="AdjustReset_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- 확대 -->
        <Popup x:Name="ZoomPopup" PlacementTarget="{Binding ElementName=ZoomButton}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource CardBg}" CornerRadius="14" Padding="16,12" Margin="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel Width="240">
                    <DockPanel>
                        <TextBlock x:Name="ZoomValue" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" />
                        <TextBlock Text="확대" />
                    </DockPanel>
                    <Slider x:Name="ZoomSlider" Minimum="1" Maximum="4" Value="1" ValueChanged="ZoomSlider_Changed" />
                    <TextBlock Text="화면에서 Ctrl+휠로 마우스 위치를 확대하고, 끌어서 옮깁니다." TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{StaticResource TextDim}" Margin="0,6,0,0" />
                    <Button Content="원래대로" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Margin="0,6,0,0" Click="ZoomReset_Click" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
