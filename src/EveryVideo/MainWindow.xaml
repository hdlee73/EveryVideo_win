<Window x:Class="EveryVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="EveryVideo" Width="1180" Height="720" MinWidth="960" MinHeight="460"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        Icon="/Assets/app.ico" AllowDrop="True" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 메뉴 -->
        <Menu x:Name="TopMenu">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="파일 열기…" InputGestureText="Ctrl+O" Click="OpenFiles_Click" />
                <MenuItem Header="폴더 열기…" InputGestureText="Ctrl+Shift+O" Click="OpenFolder_Click" />
                <MenuItem Header="주소(URL)·공유 링크 열기…" InputGestureText="Ctrl+U" Click="OpenUrl_Click" />
                <Separator />
                <MenuItem Header="구글 드라이브…" Click="GoogleDrive_Click" />
                <MenuItem Header="네트워크 (FTP · SMB)…" Click="Remote_Click" />
                <Separator />
                <MenuItem x:Name="RecentMenu" Header="최근 파일" SubmenuOpened="RecentMenu_Opened">
                    <MenuItem Header="(없음)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="캡쳐 저장 폴더 열기" Click="OpenCaptureFolder_Click" />
                <MenuItem Header="동영상 저장 폴더 열기" Click="OpenVideoFolder_Click" />
                <MenuItem Header="저장 위치 바꾸기…" Click="ChangeFolders_Click" />
                <Separator />
                <MenuItem Header="끝내기" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="재생(_P)">
                <MenuItem Header="재생 / 일시정지" InputGestureText="Space" Click="PlayPause_Click" />
                <MenuItem Header="정지" Click="Stop_Click" />
                <MenuItem Header="이전" InputGestureText="PgUp" Click="Prev_Click" />
                <MenuItem Header="다음" InputGestureText="PgDn" Click="Next_Click" />
                <Separator />
                <MenuItem Header="구간반복 (A → B → 해제)" InputGestureText="R" Click="AB_Click" />
                <MenuItem Header="반복 방식 바꾸기" InputGestureText="L" Click="Repeat_Click" />
                <MenuItem Header="빠르게" InputGestureText="]" Click="SpeedUp_Click" />
                <MenuItem Header="느리게" InputGestureText="[" Click="SpeedDown_Click" />
                <MenuItem Header="원래 속도 (1배)" InputGestureText="Backspace / \" Click="SpeedReset_Click" />
                <Separator />
                <MenuItem Header="음성 · 자막…" Click="Tracks_Click" />
            </MenuItem>
            <MenuItem Header="도구(_T)">
                <MenuItem Header="화면 캡쳐" InputGestureText="C" Click="Capture_Click" />
                <MenuItem Header="구간 저장…" InputGestureText="S" Click="Clip_Click" />
                <MenuItem Header="GIF 만들기…" InputGestureText="G" Click="Gif_Click" />
                <MenuItem Header="썸네일 만들기…" InputGestureText="T" Click="Thumbnail_Click" />
                <MenuItem Header="구간 삭제…" Click="DeleteRange_Click" />
                <MenuItem Header="여러 구간 저장 · 삭제 (구간 목록)" Click="ShowSegments_Click" />
                <Separator />
                <MenuItem Header="동영상 이어붙이기…" Click="Concat_Click" />
                <MenuItem Header="화면 녹화…" Click="Record_Click" />
                <Separator />
                <MenuItem Header="현재 시점 즐겨찾기" InputGestureText="B" Click="AddBookmark_Click" />
                <MenuItem Header="즐겨찾기 모음…" Click="AllBookmarks_Click" />
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="전체화면" InputGestureText="F / Enter" Click="Fullscreen_Click" />
                <MenuItem x:Name="SidePanelMenu" Header="재생목록 · 즐겨찾기 패널" IsCheckable="True" Click="SidePanelMenu_Click" />
                <MenuItem x:Name="TopmostMenu" Header="항상 위" IsCheckable="True" Click="Topmost_Click" />
                <Separator />
                <MenuItem Header="밝기 · 색 조절…" Click="Brightness_Click" />
                <MenuItem Header="화면 비율" Click="Aspect_Click" />
                <MenuItem Header="확대 원래대로" InputGestureText="0" Click="ZoomReset_Click" />
                <Separator />
                <MenuItem x:Name="HwMenu" Header="하드웨어 가속 디코딩" IsCheckable="True" Click="Hw_Click" />
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="단축키" Click="Shortcuts_Click" />
                <MenuItem Header="업데이트 확인…" Click="About_Click" />
                <MenuItem Header="앱 정보" Click="About_Click" />
                <MenuItem x:Name="UpdateMenu" Header="새 버전 내려받기" Visibility="Collapsed" Click="UpdateMenu_Click"
                          Foreground="{StaticResource Accent}" />
            </MenuItem>
            <MenuItem x:Name="UpdateBadge" Header="● 새 버전" Visibility="Collapsed" Foreground="{StaticResource Accent}" Click="About_Click" />
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SideColumn" Width="300" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- 동영상 -->
            <Grid Background="Black">
                <vlc:VideoView x:Name="VideoView" Background="Black">
                    <Grid x:Name="Overlay" Background="#01000000"
                          MouseWheel="Overlay_MouseWheel" MouseMove="Overlay_MouseMove"
                          MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
                          MouseRightButtonUp="Overlay_MouseRightButtonUp" AllowDrop="True" Drop="Window_Drop">

                        <!-- 처음 화면 -->
                        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="/Assets/app.png" Width="84" Height="84" Opacity="0.9" />
                            <TextBlock Text="동영상 파일을 끌어다 놓거나 열어 주세요" HorizontalAlignment="Center" FontSize="16" Margin="0,16,0,18" />
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="파일 열기" Style="{StaticResource PrimaryButton}" Click="OpenFiles_Click" />
                                <Button Content="폴더 열기" Style="{StaticResource TextButton}" Click="OpenFolder_Click" />
                                <Button Content="주소·링크" Style="{StaticResource TextButton}" Click="OpenUrl_Click" />
                                <Button Content="구글 드라이브" Style="{StaticResource TextButton}" Click="GoogleDrive_Click" />
                                <Button Content="FTP · SMB" Style="{StaticResource TextButton}" Click="Remote_Click" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- 재생이 끝났을 때 -->
                        <StackPanel x:Name="EndPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="재생이 끝났습니다" HorizontalAlignment="Center" FontSize="16" Margin="0,0,0,14" />
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="다시 재생" Style="{StaticResource PrimaryButton}" Click="Replay_Click" />
                                <Button Content="다른 파일 열기" Style="{StaticResource TextButton}" Click="OpenFiles_Click" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- 화면 안내 글 -->
                        <Border x:Name="Osd" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="14,8"
                                Background="#B0000000" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="OsdText" FontSize="16" Foreground="White" />
                        </Border>

                        <!-- 전체화면일 때 조작 막대가 여기로 옮겨진다 -->
                        <Border x:Name="FsControlsHost" VerticalAlignment="Bottom" Background="#E6181820" Visibility="Collapsed" />
                    </Grid>
                </vlc:VideoView>
            </Grid>

            <!-- 동영상과 옆 패널 사이: 끌어서 폭 조절 -->
            <GridSplitter x:Name="SideSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{StaticResource PanelBg}" Cursor="SizeWE" Focusable="False" DragCompleted="SideSplitter_DragCompleted">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Border Width="2" Height="36" CornerRadius="1" Background="{StaticResource Line}" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 재생목록 · 즐겨찾기 · 구간 -->
            <Border x:Name="SidePanel" Grid.Column="2" Background="{StaticResource PanelBg}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,10,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="PlaylistTab" Content="재생목록" IsChecked="True" GroupName="side" Checked="SideTab_Changed"
                                     Style="{StaticResource TabRadio}" Height="32" Margin="0,0,2,0" />
                        <RadioButton x:Name="BookmarkTab" Grid.Column="1" Content="즐겨찾기" GroupName="side" Checked="SideTab_Changed"
                                     Style="{StaticResource TabRadio}" Height="32" Margin="2,0" />
                        <RadioButton x:Name="SegmentTab" Grid.Column="2" Content="구간" GroupName="side" Checked="SideTab_Changed"
                                     Style="{StaticResource TabRadio}" Height="32" Margin="2,0,0,0" />
                    </Grid>

                    <!-- 재생목록 -->
                    <DockPanel x:Name="PlaylistPanel">
                        <DockPanel DockPanel.Dock="Top" Margin="14,0,8,2">
                            <Button x:Name="PlaylistSortButton" DockPanel.Dock="Right" Content="정렬 ▾" Style="{StaticResource TextButton}" MinWidth="0"
                                    Padding="10,0" Height="28" Foreground="{StaticResource Text}" Click="PlaylistSort_Click" />
                            <TextBlock x:Name="PlaylistCount" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"
                                       Text="끌어서 순서 바꾸기 · × 로 빼기" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,4,8,8">
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcAdd}" ToolTip="파일 추가" Click="AddFiles_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcFolder}" ToolTip="폴더 추가" Click="AddFolder_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcUp}" ToolTip="위로" Click="PlaylistUp_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcDown}" ToolTip="아래로" Click="PlaylistDown_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcDelete}" ToolTip="고른 항목 목록에서 빼기 (Del)" Click="PlaylistRemove_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcClose}" ToolTip="목록 비우기" Click="PlaylistClear_Click" />
                        </StackPanel>
                        <ListBox x:Name="PlaylistBox" Margin="6,0" MouseDoubleClick="PlaylistBox_DoubleClick" KeyDown="PlaylistBox_KeyDown"
                                 AllowDrop="True" Drop="Window_Drop" SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Background="Transparent">
                                        <Button x:Name="del" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                Tag="{StaticResource IcClose}" ToolTip="목록에서 빼기 (파일은 그대로)" Click="PlaylistItemRemove_Click"
                                                Visibility="Hidden" Margin="4,0,0,0" />
                                        <Path x:Name="ic" Data="{StaticResource IcMovie}" Fill="{StaticResource TextDim}" Width="14" Height="14"
                                              Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock x:Name="tx" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="ic" Property="Data" Value="{StaticResource IcPlay}" />
                                            <Setter TargetName="ic" Property="Fill" Value="{StaticResource Accent}" />
                                            <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter TargetName="tx" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="del" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 즐겨찾기 (지금 동영상) -->
                    <DockPanel x:Name="BookmarkPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,4,8,8">
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcBookmarkAdd}" ToolTip="현재 시점 즐겨찾기 (B)" Click="AddBookmark_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcEdit}" ToolTip="메모 고치기" Click="EditBookmark_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcDelete}" ToolTip="지우기" Click="DeleteBookmark_Click" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcBookmarks}" ToolTip="모든 동영상의 즐겨찾기" Click="AllBookmarks_Click" />
                        </StackPanel>
                        <TextBlock x:Name="BookmarkEmpty" DockPanel.Dock="Top" Margin="16,8" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                   Text="재생 중에 B 키나 ★ 버튼을 누르면 지금 시점을 즐겨찾기 합니다. 다음에 이 동영상을 열면 여기서 바로 이동할 수 있습니다." />
                        <ListBox x:Name="BookmarkBox" Margin="6,0" MouseDoubleClick="BookmarkBox_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding NoteOrTime}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 여러 구간 -->
                    <DockPanel x:Name="SegmentPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Bottom" Margin="10,4,10,10">
                            <WrapPanel>
                                <Button Content="+ A-B 구간 추가" Style="{StaticResource TextButton}" Foreground="{StaticResource Text}" Margin="0,0,6,6"
                                        ToolTip="A-B 로 고른 구간을 목록에 넣습니다 (Insert)" Click="AddSegment_Click" />
                                <Button Content="모두 지우기" Style="{StaticResource TextButton}" Foreground="{StaticResource Text}" Margin="0,0,6,6"
                                        Click="ClearSegments_Click" />
                            </WrapPanel>
                            <Button Content="체크한 구간 각각 저장" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Click="SaveSegmentsEach_Click" />
                            <Button Content="체크한 구간을 하나로 합쳐 저장" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Click="SaveSegmentsJoined_Click" />
                            <Button Content="체크한 구간을 지운 영상 저장" Style="{StaticResource PrimaryButton}" Background="{StaticResource Danger}"
                                    Click="DeleteSegments_Click" />
                        </StackPanel>
                        <TextBlock x:Name="SegmentHint" DockPanel.Dock="Top" Margin="16,4,16,8" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12"
                                   Text="Shift 를 누른 채 시간 막대를 끌거나, A-B 를 고른 뒤 '구간 추가'를 누르면 구간이 쌓입니다. 체크한 구간을 한꺼번에 저장하거나 지울 수 있습니다." />
                        <ListBox x:Name="SegmentBox" Margin="6,0" MouseDoubleClick="SegmentBox_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Background="Transparent">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                Tag="{StaticResource IcClose}" ToolTip="빼기" Click="SegmentRemove_Click" />
                                        <CheckBox IsChecked="{Binding Checked}" VerticalAlignment="Center" Margin="0,0,6,0" Click="SegmentCheck_Click" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Range}" Foreground="{StaticResource Text}" />
                                            <TextBlock Text="{Binding LengthText}" FontSize="11.5" Foreground="{StaticResource TextDim}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 조작 막대 -->
        <Border x:Name="ControlsHost" Grid.Row="2" Background="{StaticResource PanelBg}">
            <StackPanel x:Name="ControlBar" Margin="12,2,12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeText" Text="00:00" VerticalAlignment="Center" Width="62" Foreground="{StaticResource TextDim}" />
                    <Grid x:Name="SeekArea" Grid.Column="1" Height="34" Background="Transparent">
                        <Canvas x:Name="SegmentCanvas" ClipToBounds="False" IsHitTestVisible="False" />
                        <Slider x:Name="SeekSlider" Maximum="1" SmallChange="1000" LargeChange="10000"
                                MouseMove="Seek_MouseMove" MouseLeave="Seek_MouseLeave" ValueChanged="Seek_ValueChanged" />
                        <Canvas x:Name="MarkerCanvas" ClipToBounds="False" />
                    </Grid>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" VerticalAlignment="Center" Width="62"
                               TextAlignment="Right" Foreground="{StaticResource TextDim}" />
                </Grid>

                <!-- 왼쪽: 볼륨 / 가운데: 재생 / 오른쪽: 도구 -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcVolume}" ToolTip="음소거 (M)"
                                Click="Mute_Click" />
                        <Slider x:Name="VolumeSlider" Width="100" Maximum="200" Value="100" ValueChanged="Volume_Changed"
                                ToolTip="볼륨 (↑↓, 마우스 휠) · 100% 넘게 키울 수 있음" />
                        <TextBlock x:Name="VolumeText" Text="100%" Width="42" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />
                        <Button x:Name="SpeedButton" Content="1.0x" Style="{StaticResource TextButton}" MinWidth="54" Padding="8,0" Margin="4,0,0,0"
                                Foreground="{StaticResource Text}" ToolTip="재생 속도 ([ ]) · 오른쪽 클릭하면 원래 속도" Click="Speed_Click"
                                MouseRightButtonUp="SpeedButton_RightClick" />
                        <Button x:Name="SpeedResetButton" Content="1x" Style="{StaticResource TextButton}" MinWidth="0" Padding="8,0" Margin="2,0,0,0"
                                Height="28" ToolTip="원래 속도로 (Backspace)" Click="SpeedReset_Click" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="12,0">
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcPrev}" ToolTip="이전 (PgUp)" Click="Prev_Click" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcReplay10}" ToolTip="10초 뒤로 (←: 5초)" Click="Back10_Click" Margin="4,0" />
                        <Button x:Name="PlayButton" Style="{StaticResource BigIconButton}" Tag="{StaticResource IcPlay}" ToolTip="재생 / 일시정지 (Space, 화면 클릭)"
                                Click="PlayPause_Click" Margin="6,0" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcForward10}" ToolTip="10초 앞으로 (→: 5초)" Click="Fwd10_Click" Margin="4,0" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcNext}" ToolTip="다음 (PgDn)" Click="Next_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ABButton" Content="A-B" Style="{StaticResource TextButton}" MinWidth="50" Padding="8,0"
                                Foreground="{StaticResource Text}" ToolTip="구간반복: 누를 때마다 A 지정 → B 지정 → 해제 (R). 반복 중에는 그 구간 안에서만 이동" Click="AB_Click" />
                        <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcRepeat}" ToolTip="반복" Click="Repeat_Click" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcBrightness}" ToolTip="밝기 · 색 조절" Click="Brightness_Click" x:Name="BrightnessButton" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcTracks}" ToolTip="음성 · 자막" Click="Tracks_Click" x:Name="TracksButton" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcAspect}" ToolTip="화면 비율" Click="Aspect_Click" x:Name="AspectButton" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcZoom}" ToolTip="확대 (Ctrl+휠, 끌어서 이동)" Click="Zoom_Click" x:Name="ZoomButton" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcCamera}" ToolTip="화면 캡쳐 (C)" Click="Capture_Click" />
                        <Button x:Name="EditButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcCut}" ToolTip="구간 저장 · GIF · 썸네일 · 구간 삭제" Click="EditMenu_Click" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcBookmarkAdd}" ToolTip="현재 시점 즐겨찾기 (B)" Click="AddBookmark_Click" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcQueue}" ToolTip="재생목록 · 즐겨찾기 · 구간 패널" Click="SidePanelToggle_Click" />
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Tag="{StaticResource IcFullscreen}" ToolTip="전체화면 (F)"
                                Click="Fullscreen_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 탐색 미리보기 -->
        <Popup x:Name="PreviewPopup" PlacementTarget="{Binding ElementName=SeekSlider}" Placement="Relative"
               AllowsTransparency="True" IsHitTestVisible="False">
            <Border Background="#F0101016" CornerRadius="10" Padding="4" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <Border x:Name="PreviewFrame" Width="192" Height="108" CornerRadius="6" Background="Black" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="PreviewTime" HorizontalAlignment="Center" Margin="0,4,0,2" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- 밝기 · 색 -->
        <Popup x:Name="BrightnessPopup" PlacementTarget="{Binding ElementName=BrightnessButton}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource CardBg}" CornerRadius="14" Padding="16,12" Margin="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel Width="260">
                    <DockPanel>
                        <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" />
                        <TextBlock Text="밝기" />
                    </DockPanel>
                    <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" ValueChanged="Adjust_Changed" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="ContrastValue" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" />
                        <TextBlock Text="대비" />
                    </DockPanel>
                    <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" ValueChanged="Adjust_Changed" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="SaturationValue" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" />
                        <TextBlock Text="채도" />
                    </DockPanel>
                    <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" ValueChanged="Adjust_Changed" />
                    <Button Content="원래대로" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="AdjustReset_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- 확대 -->
        <Popup x:Name="ZoomPopup" PlacementTarget="{Binding ElementName=ZoomButton}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource CardBg}" CornerRadius="14" Padding="16,12" Margin="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel Width="240">
                    <DockPanel>
                        <TextBlock x:Name="ZoomValue" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" />
                        <TextBlock Text="확대" />
                    </DockPanel>
                    <Slider x:Name="ZoomSlider" Minimum="1" Maximum="4" Value="1" ValueChanged="ZoomSlider_Changed" />
                    <TextBlock Text="화면에서 Ctrl+휠로 마우스 위치를 확대하고, 끌어서 옮깁니다." TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{StaticResource TextDim}" Margin="0,6,0,0" />
                    <Button Content="원래대로" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Margin="0,6,0,0" Click="ZoomReset_Click" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
